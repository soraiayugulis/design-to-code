# Design-to-Code pipeline configuration example.
# Copy to pipeline.yml in the target workspace root (or pass via --config).

ai:
  host: localhost
  port: 11434
  model: codellama:13b
  # Total generation budget per call. On CPU-only runners (e.g. GitHub Actions),
  # a ~20k-char prompt can take far longer than on a GPU machine — size this
  # accordingly (e.g. 1800000 = 30min).
  timeoutMs: 300000
  # Optional: Ollama context window override (sent as options.num_ctx).
  # Set when prompts approach or exceed the model's default context; otherwise
  # Ollama silently truncates the prompt.
  # numCtx: 32768

git:
  branchPrefix: feature/ai-gen
  commitMessageFormat: conventional
  # Base ref used for `git diff <baseRef> -- design/` spec change analysis.
  # In CI the workflow passes the PR base SHA via --base-ref.
  baseRef: HEAD~1

qualityGate:
  coverageThreshold: 90.0
  coverageType: LINE
  timeoutSeconds: 900
  maxBuildRetries: 2

build:
  gradleTasks:
    - clean
    - build
  useDaemon: false

retry:
  maxAttempts: 3
  initialDelayMs: 1000
  maxDelayMs: 10000
  backoffMultiplier: 2.0

outputValidation:
  # When true, generated files must land inside allowedRoots and spec-declared
  # target files must be modified; violations trigger bounded corrective retries.
  enabled: true
  # When true, files written outside the spec's declared targets also fail the run.
  strictMode: false
  maxCorrectiveRetries: 2
  # Workspace-relative roots that generated files may be written under.
  # When omitted or empty, roots are auto-detected from existing
  # **/src/{main,test}/{java,kotlin} directories.
  allowedRoots:
    - app/src/main/java
    - app/src/test/java
